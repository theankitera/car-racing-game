{
  "name": "apex-nitro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Apex Nitro - a full 3D arcade racing game built with React Three Fiber",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=.smoke/smoke.mjs --log-level=warning && node .smoke/smoke.mjs",
    "balance": "esbuild scripts/balance.ts --bundle --platform=node --format=esm --outfile=.smoke/balance.mjs --log-level=warning && node .smoke/balance.mjs",
    "startline": "esbuild scripts/startline.ts --bundle --platform=node --format=esm --outfile=.smoke/startline.mjs --log-level=warning && node .smoke/startline.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
